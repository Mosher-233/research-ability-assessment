# DeepSeek API Key (required for AI analysis features)
DEEPSEEK_API_KEY=your_api_key_here

# Application environment (dev / prod)
APP_ENV=dev

# Database (defaults match docker-compose.yml)
# DB_HOST=localhost
# DB_USER=mysqluser
# DB_PASSWORD=mysqlpassword
# DB_NAME=research_assessment

# Neo4j (defaults match docker-compose.yml)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password123

# Redis (defaults match docker-compose.yml)
# REDIS_HOST=localhost
# REDIS_PASSWORD=
