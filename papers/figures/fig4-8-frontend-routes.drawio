<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="前端路由结构">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="root" value="/" style="ellipse;whiteSpace=wrap;html=1;fillColor=#6c8ebf;strokeColor=#6c8ebf;fontColor=#ffffff;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="10" width="60" height="40" as="geometry" />
        </mxCell>
        <mxCell id="login" value="/login&#xa;Login.vue&#xa;（登录页）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="90" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="register" value="/register&#xa;Register.vue&#xa;（注册页）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="90" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="dashboard" value="/dashboard&#xa;Dashboard.vue&#xa;（布局容器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="90" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tasks" value="/dashboard/tasks&#xa;TaskManagement.vue&#xa;（任务管理）" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="task_detail" value="创建/编辑任务&#xa;分配学生&#xa;状态流转" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="tasks">
          <mxGeometry x="10" y="35" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="evidences" value="/dashboard/evidences&#xa;EvidenceManagement.vue&#xa;（证据管理）" style="swimlane;startSize=25;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="200" width="220" height="100" as="geometry" />
