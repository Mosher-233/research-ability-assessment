<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="JWT认证流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="JWT认证流程图" style="text;html=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="5" width="180" height="25" as="geometry" />
        </mxCell>
        <mxCell id="client" value="客户端" style="swimlane;startSize=25;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="40" width="200" height="420" as="geometry" />
        </mxCell>
        <mxCell id="server" value="服务器端" style="swimlane;startSize=25;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="40" width="250" height="420" as="geometry" />
        </mxCell>
        <mxCell id="db" value="数据库" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="40" width="120" height="420" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. POST /register&#xa;   {email, password}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="client">
          <mxGeometry x="10" y="30" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="2. bcrypt加密密码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="server">
          <mxGeometry x="10" y="40" width="150" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="3. INSERT users" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="db">
          <mxGeometry x="10" y="40" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="4. 生成JWT令牌&#xa;   {user_id, role}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="server">
          <mxGeometry x="10" y="90" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="5. 返回 {token}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="client">
          <mxGeometry x="10" y="90" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="7. POST /login&#xa;   {email, password}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="client">
          <mxGeometry x="10" y="170" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="8. SELECT ... WHERE email" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="db">
          <mxGeometry x="10" y="200" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="9. bcrypt比较密码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="server">
          <mxGeometry x="10" y="220" width="150" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m9" value="10. 生成JWT令牌" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="server">
          <mxGeometry x="10" y="270" width="150" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m10" value="11. 返回 {token}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;" vertex="1" parent="client">
          <mxGeometry x="10" y="270" width="180" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="12. GET /api/v1/user/info&#xa;   Authorization: Bearer {token}" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="client">
          <mxGeometry x="0" y="350" width="200" height="45" as="geometry" />
        </mxCell>
        <mxCell id="m12" value="13. AuthMiddleware验证&#xa;  → 注入user_id, role到Context" style="rounded=1;whiteSpace=wrap;html=1;fontSize=9;" vertex="1" parent="server">
          <mxGeometry x="10" y="350" width="190" height="45" as="geometry" />
        </mxCell>
