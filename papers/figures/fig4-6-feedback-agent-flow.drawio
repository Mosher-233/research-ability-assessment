<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="FeedbackAgent流程">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="接收证据" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="80" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="构建System Prompt&#xa;（定义评价专家角色与标准）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="70" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="构建User Prompt&#xa;（证据内容 + JSON输出格式）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="llmClient.Chat(ctx, messages)&#xa;调用DeepSeek API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="210" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="API调用成功？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="75" y="280" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="ParseFeedbackResponse()&#xa;解析LLM返回的JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="370" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="存储到feedbacks表&#xa;(KBM级别/优点/不足/建议)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="end" value="返回FeedbackResult" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="80" y="510" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="err" value="返回错误信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="285" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="s2" target="s3">
