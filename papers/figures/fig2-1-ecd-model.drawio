<mxfile host="drawio" version="26.0.0">
  <diagram name="ECD三层模型">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="sm" value="学生模型 (Student Model)&#xa;回答：要测量什么？&#xa;&#xa;四个能力维度：&#xa;1.文献检索与综述&#xa;2.研究设计与实验&#xa;3.数据分析与解释&#xa;4.批判性思维与创新" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="80" y="40" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="em" value="证据模型 (Evidence Model)&#xa;回答：如何提取证据？&#xa;&#xa;10项KBMs（行为标志物）&#xa;→ 四级量规 (Rubrics)&#xa;→ 证据规则 + 测量规则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tm" value="任务模型 (Task Model)&#xa;回答：证据产生的情境？&#xa;&#xa;教师创建评价任务&#xa;→ 学生提交过程证据&#xa;→ AI Agent 自动评估" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="760" y="40" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sm" target="em">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="em" target="tm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="title" value="证据中心评价模式（ECD）三层模型" style="text;html=1;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="10" width="400" height="25" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
